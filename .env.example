# Copy to .env.local for local testing; on Hostinger set these under
# Websites → your site → Node.js → Environment variables. Never commit real values.
#
# Contact form email delivery (see lib/mailer.js). Leave SMTP_USER/SMTP_PASS
# empty to turn email off: enquiries are then only written to the server log.
SMTP_USER=
SMTP_PASS=
# Optional: where enquiries go (defaults to SMTP_USER)
CONTACT_TO_EMAIL=
# Optional: defaults are smtp.hostinger.com and 465 (SSL). Use 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=
